{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokemon-card-sculpt",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "CARD_IMAGES",
      "bucket_name": "pokemon-card-images"
    }
  ]
}
